
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkyCast Weather App</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    color: white;
    background: linear-gradient(135deg, #101a40, #246b9e, #65c8d0);
}

.app {
    width: 100%;
    max-width: 450px;
    padding: 30px;
    text-align: center;
    border-radius: 25px;
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.25);
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    backdrop-filter: blur(15px);
}

h1 {
    margin-bottom: 10px;
}

.subtitle {
    margin-bottom: 25px;
    color: #e0f5ff;
}

.search {
    display: flex;
    gap: 8px;
    margin-bottom: 15px;
}

input {
    width: 100%;
    min-width: 0;
    padding: 13px;
    border: none;
    border-radius: 10px;
    outline: none;
    font-size: 15px;
}

button {
    padding: 13px 16px;
    border: none;
    border-radius: 10px;
    background: #ffd166;
    color: #17233e;
    font-weight: bold;
    cursor: pointer;
}

button:disabled {
    opacity: 0.6;
}

#message {
    margin: 12px 0;
    font-size: 14px;
}

.weather {
    margin-top: 15px;
}

.weather[hidden] {
    display: none;
}

#icon {
    width: 100px;
    height: 100px;
}

#temp {
    font-size: 55px;
    margin: 5px;
}

#condition {
    font-size: 19px;
    margin: 10px;
}

#feels {
    color: #e0f5ff;
    margin-bottom: 25px;
}

.details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.detail {
    padding: 18px 10px;
    border-radius: 15px;
    background: rgba(255,255,255,0.13);
}

.detail p {
    margin: 8px 0;
    font-size: 13px;
    color: #e0f5ff;
}

.detail strong {
    font-size: 16px;
}

footer {
    margin-top: 25px;
    font-size: 12px;
    color: #e0f5ff;
}

@media (max-width: 380px) {
    .app {
        padding: 20px;
    }

    button {
        padding: 12px;
    }
}
</style>
</head>

<body>
<div class="app">

    <h1>🌦️ SkyCast</h1>
    <p class="subtitle">Discover the weather around you</p>

    <form class="search" id="weatherForm">
        <input
            type="text"
            id="city"
            placeholder="Enter city name..."
            aria-label="City name"
            required
        >
        <button id="searchBtn" type="submit">Search</button>
    </form>

    <p id="message" role="status" aria-live="polite"></p>

    <div class="weather" id="weather" hidden>
        <h2 id="cityName"></h2>
        <p id="localTime"></p>

        <img id="icon" src="" alt="Weather condition">

        <h2 id="temp"></h2>
        <p id="condition"></p>
        <p id="feels"></p>

        <div class="details">
            <div class="detail">
                💧
                <p>Humidity</p>
                <strong id="humidity"></strong>
            </div>

            <div class="detail">
                💨
                <p>Wind Speed</p>
                <strong id="wind"></strong>
            </div>

            <div class="detail">
                ☀️
                <p>UV Index</p>
                <strong id="uv"></strong>
            </div>

            <div class="detail">
                🌡️
                <p>Pressure</p>
                <strong id="pressure"></strong>
            </div>
        </div>

        <p id="updated" style="margin-top:20px;font-size:12px"></p>
    </div>

    <footer>Powered by WeatherAPI.com</footer>
</div>

<script>
const API_KEY = "a30fed2ff29542509f1165355260910";
const API_URL = "https://api.weatherapi.com/v1/current.json";

const form = document.getElementById("weatherForm");
const cityInput = document.getElementById("city");
const message = document.getElementById("message");
const weather = document.getElementById("weather");
const searchBtn = document.getElementById("searchBtn");

form.addEventListener("submit", async function(event) {
    event.preventDefault();

    const city = cityInput.value.trim();

    if (!city) {
        message.textContent = "Please enter a city name.";
        return;
    }

    searchBtn.disabled = true;
    searchBtn.textContent = "Loading...";
    message.textContent = "Fetching weather...";
    weather.hidden = true;

    try {
        const url = new URL(API_URL);
        url.searchParams.set("key", API_KEY);
        url.searchParams.set("q", city);
        url.searchParams.set("aqi", "yes");

        const response = await fetch(url);
        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.error?.message || "Unable to get weather data."
            );
        }

        showWeather(data);
        message.textContent = "";

    } catch (error) {
        message.textContent =
            error.message || "Network error. Please try again.";
    } finally {
        searchBtn.disabled = false;
        searchBtn.textContent = "Search";
    }
});

function showWeather(data) {
    const loc = data.location;
    const cur = data.current;

    document.getElementById("cityName").textContent =
        loc.name + ", " + loc.country;

    document.getElementById("localTime").textContent =
        "Local time: " + loc.localtime;

    document.getElementById("icon").src =
        "https:" + cur.condition.icon;

    document.getElementById("icon").alt = cur.condition.text;

    document.getElementById("temp").textContent =
        Math.round(cur.temp_c) + "°C";

    document.getElementById("condition").textContent =
        cur.condition.text;

    document.getElementById("feels").textContent =
        "Feels like " + Math.round(cur.feelslike_c) + "°C";

    document.getElementById("humidity").textContent =
        cur.humidity + "%";

    document.getElementById("wind").textContent =
        cur.wind_kph + " km/h";

    document.getElementById("uv").textContent = cur.uv;

    document.getElementById("pressure").textContent =
        cur.pressure_mb + " mb";

    document.getElementById("updated").textContent =
        "Last updated: " + cur.last_updated;

    weather.hidden = false;
}
</script>
</body>
</html>
